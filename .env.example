# ── Required ──
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=your_api_key_here
LETTERBOXD_FRIENDS=friend1,friend2,friend3

# ── Optional ──

# Leave blank to auto-detect (prefers an administrator account).
JELLYFIN_USER_ID=

# Display names for the Letterboxd usernames above.
LETTERBOXD_NICKNAMES=friend1=Alice,friend2=Bob

# How long fetched data stays fresh.
CACHE_TTL_SECONDS=3600

# When Letterboxd or Jellyfin is unreachable, expired data is served instead of
# nothing, up to this age. The UI says how old it is. Set 0 to disable.
STALE_MAX_AGE_SECONDS=604800

# Timeout for every outbound HTTP request.
HTTP_TIMEOUT_SECONDS=15

# How many films must want a film for it to count as "overlap". With a lot of
# friends, raise this — "any two people" stops meaning much.
OVERLAP_MIN_FRIENDS=2

# Letterboxd and Jellyfin often disagree about release year by a year.
YEAR_TOLERANCE=1

# Concurrency and retries against Letterboxd. Keep these modest: it is a free
# service being scraped, and it will rate-limit an impatient client.
LETTERBOXD_MAX_WORKERS=4
LETTERBOXD_RETRIES=2

# Per-sync ceiling on per-film TMDB lookups, used to match films filed under a
# different title. Results are cached permanently, so repeated refreshes work
# through the backlog. Set 0 to disable.
TMDB_RESOLVE_BUDGET=75

# Where the SQLite cache lives.
CACHE_DB_PATH=data/cache.db
